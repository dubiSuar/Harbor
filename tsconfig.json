{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // Type per-icon Phosphor deep imports from the published .d.ts files
    // instead of type-checking the package's .tsx sources.
    "paths": {
      "phosphor-react-native/src/icons/*": [
        "./node_modules/phosphor-react-native/lib/typescript/icons/*.d.ts"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
